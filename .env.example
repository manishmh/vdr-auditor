# Local development defaults. Copy to .env (gitignored, never commit).
# Never put real credentials or contract contents in version control.
# For production, see .env.prod (name checklist, gitignored) and set the
# values in the Vercel dashboard — never copy .env values into prod files.

# Inference: mock (deterministic, no network) or baseten (live LLM).
INFERENCE_PROVIDER=mock

# Real inference (server-side only, never NEXT_PUBLIC_). Required when
# INFERENCE_PROVIDER=baseten. Find model slugs in the Baseten Model APIs catalog.
# BASETEN_API_KEY=
# BASETEN_MODEL_ID=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_TIMEOUT_MS=60000
BASETEN_MAX_RETRIES=2
# Set to "false" for models without json_schema support (e.g. Muse Spark Open):
# the provider then requests JSON in the prompt and parses content defensively.
BASETEN_STRUCTURED_OUTPUTS=true

# Storage: local (single-process JSON files, no credentials) or mongodb.
STORAGE_BACKEND=local
STORAGE_DIR=.data
# MongoDB (required when STORAGE_BACKEND=mongodb). Atlas in production:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true
# Local docker for development:
# MONGODB_URI=mongodb://127.0.0.1:27017/vdr_auditor
MONGODB_DB=vdr_auditor

# Optional: dedicated database for the MongoDB repository test suite.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/vdr_auditor_test

MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
# NOTE: Vercel serverless functions accept ~4.5 MB request bodies. Pilot
# deployments on Vercel must set MAX_UPLOAD_BYTES at or below ~4 MB.
# NOTE: the mongodb backend stores each original inline (16 MB BSON document
# ceiling). With STORAGE_BACKEND=mongodb, keep MAX_UPLOAD_BYTES at or below
# ~14 MB so uploads plus extracted text fit; larger files fail honestly with
# a storage error, never silently. GridFS is future work if needed.

# Pilot access gate: Bearer credential required by every API route when set.
# Generate with `openssl rand -hex 32`. Required in production (NODE_ENV=production).
# Single shared credential for a trusted pilot team — not per-user auth (see docs/security.md).
# PILOT_ACCESS_TOKEN=

# Express API port for local development (`npm run dev:api`).
PORT=3001

# Browser origin allowed to call the API (CORS). Required in production.
# FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Frontend only: Express API base URL. Unset = same-origin (local dev proxy
# forwards /api/* to localhost:3001; single-project Vercel prod serves the
# API from the same deployment, so leave it unset there too). Set it ONLY
# for a split frontend/separate-backend deployment.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.vercel.app

# Frontend only: build-time mirrors of the server upload caps, used for the
# upload label and an early client-side pre-check. The server always
# re-validates, so keep these in sync with the deployment's server settings.
# NEXT_PUBLIC_MAX_UPLOAD_MB=20
# NEXT_PUBLIC_MAX_PDF_PAGES=200
