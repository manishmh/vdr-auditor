{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfjs-dist/{standard_fonts/**,legacy/build/pdf.worker.mjs}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
