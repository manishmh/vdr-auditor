# Copy to frontend/.env.local and adjust. Never commit frontend/.env.local.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets here.

# Required. Base URL of the backend API (no trailing slash).
# Local default below. In production on Vercel, set this to the deployed
# backend's public HTTPS URL, e.g. https://<your-backend-domain> (this value
# is baked in at build time, so rebuild after changing it).
NEXT_PUBLIC_API_URL=http://localhost:4000
