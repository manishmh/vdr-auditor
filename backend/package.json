{
  "name": "vdr-auditor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VDR Auditor backend API (Express + MongoDB). Phase 1: health endpoints only.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
