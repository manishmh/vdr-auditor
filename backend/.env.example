# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Required variables are validated at startup; the backend refuses to boot
# with an actionable error naming the missing variable (never its value).

# Optional locally ("development"). Set NODE_ENV=production in Vercel.
NODE_ENV=development

# Optional. Port for local `npm run dev` / `npm run start`. Defaults to 4000.
# Ignored on Vercel: serverless functions do not listen on a port.
PORT=4000

# Required. Exact origin of the frontend, used for CORS. No wildcard allowed.
# Local default below. In production on Vercel, set this to the deployed
# frontend's actual HTTPS origin, e.g. https://<your-frontend-domain>.
FRONTEND_ORIGIN=http://localhost:3000

# Optional at boot, required for readiness. Paste your own MongoDB connection
# string here (with your database user and password). For Atlas, create the
# database user yourself and allowlist your IP locally; for Vercel, set the
# production value in the Vercel dashboard and allowlist Vercel's access in
# Atlas network settings.
# When unset or unreachable, GET /api/health/ready returns HTTP 503.
MONGODB_URI=

# Optional. Database name used for the readiness ping. Defaults to vdr_auditor.
MONGODB_DB_NAME=vdr_auditor

# Optional. Maximum accepted PDF size in bytes for document uploads.
# Default: 26214400 (25 MiB).
MAX_PDF_BYTES=26214400
